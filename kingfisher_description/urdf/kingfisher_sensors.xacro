<?xml version="1.0"?>
<!--
Sensor links of the Kingfisher M200.

Every macro creates a plainly named link (<name>_link) on a fixed joint to
base_link. The Gazebo sensors attached to these links are in
kingfisher_gazebo/urdf/kingfisher_sensors_gazebo.xacro.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="kingfisher_sensor_link" params="name xyz rpy radius length mass color:='0.2 0.2 0.2 1.0'">
    <link name="${name}_link">
      <visual name="${name}_visual">
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${name}_visual_material">
          <color rgba="${color}"/>
        </material>
      </visual>
      <collision name="${name}_collision">
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <inertia
          ixx="${(mass/12) * (3*radius*radius + length*length)}"
          iyy="${(mass/12) * (3*radius*radius + length*length)}"
          izz="${(mass/2) * radius*radius}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="base_link"/>
      <child link="${name}_link"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="kingfisher_gps" params="name:=gps x:=0 y:=0 z:=0 R:=0 P:=0 Y:=0">
    <xacro:kingfisher_sensor_link name="${name}" xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}"
                                  radius="0.04" length="0.03" mass="0.2"/>
  </xacro:macro>

  <xacro:macro name="kingfisher_imu" params="name:=imu x:=0 y:=0 z:=0 R:=0 P:=0 Y:=0">
    <xacro:kingfisher_sensor_link name="${name}" xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}"
                                  radius="0.02" length="0.01" mass="0.05"/>
  </xacro:macro>

  <!-- 2D lidar, sized as a SICK TiM571 -->
  <xacro:macro name="kingfisher_lidar" params="name:=lidar x:=0 y:=0 z:=0 R:=0 P:=0 Y:=0">
    <xacro:kingfisher_sensor_link name="${name}" xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}"
                                  radius="0.03" length="0.086" mass="0.25"/>
  </xacro:macro>

  <!-- Monocular camera. <name>_link is the camera body (x forward, z up),
       <name>_link_optical the REP 103 optical frame (z forward). -->
  <xacro:macro name="kingfisher_camera" params="name:=camera x:=0 y:=0 z:=0 R:=0 P:=0 Y:=0">
    <xacro:kingfisher_sensor_link name="${name}" xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}"
                                  radius="0.02" length="0.04" mass="0.1"/>
    <link name="${name}_link_optical"/>
    <joint name="${name}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      <parent link="${name}_link"/>
      <child link="${name}_link_optical"/>
    </joint>
  </xacro:macro>
</robot>
