<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kingfisher_gazebo</name>
  <version>1.0.0</version>
  <description>
    Gazebo (gz-sim) layer of the Clearpath Kingfisher M200 ASV: hydrodynamics,
    thrusters, sensors and ground truth on top of kingfisher_description.
  </description>
  <maintainer email="luisfelipewb@gmail.com">Luis Batista</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>kingfisher_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- vrx::Surface and vrx::SimpleHydrodynamics -->
  <exec_depend>vrx_gazebo</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
