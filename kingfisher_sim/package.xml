<?xml version="1.0"?>
<package format="3">
  <name>kingfisher_sim</name>
  <version>1.0.0</version>
  <description>
    Simulation glue for the Clearpath Kingfisher in VRX: launch files and the
    cmd_drive translator that turns normalized [-1, 1] thruster commands into
    the thrust forces consumed by the Gazebo Thruster plugin.
  </description>
  <maintainer email="luisfelipewb@gmail.com">Luis Batista</maintainer>
  <license>BSD</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>kingfisher_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>kingfisher_gazebo</exec_depend>
  <exec_depend>vrx_gz</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
