<?xml version="1.0"?>
<package format="3">
  <name>kingfisher_sim</name>
  <version>1.0.0</version>
  <description>
    Simulation glue for the Clearpath Kingfisher in VRX: launch files and the
    cmd_drive translator that turns normalized [-1, 1] thruster commands into
    the thrust forces consumed by the Gazebo Thruster plugin.
  </description>
  <maintainer email="luisfelipewb@gmail.com">Luis Batista</maintainer>
  <license>BSD</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>kingfisher_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>kingfisher_gazebo</exec_depend>
  <exec_depend>vrx_gz</exec_depend>
  <exec_depend>lac_symphonie</exec_depend>
  <!-- robot.launch.py: the boat's nodes and config/kingfisher.yaml -->
  <exec_depend>kingfisher_bringup</exec_depend>
  <exec_depend>kingfisher_twist</exec_depend>
  <exec_depend>kingfisher_viz</exec_depend>
  <!-- sail_controller, and the stepper command it sends to sail_stepper_sim -->
  <exec_depend>kingfisher_sail</exec_depend>
  <!-- joy_teleop with kingfisher_teleop's config -->
  <exec_depend>kingfisher_teleop</exec_depend>
  <exec_depend>joy_teleop</exec_depend>
  <exec_depend>phidgets_msgs</exec_depend>
  <!-- anemometer_relay, drive_mux -->
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>kingfisher_localization</exec_depend>
  <!-- wind_bridge -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
